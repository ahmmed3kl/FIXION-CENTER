# FIXION Backend API Environment Configuration Example
PORT=3000
APP_ENV=production
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_SQL_ENDPOINT=https://your-endpoint.neon.tech/sql
JWT_SECRET=your_super_secure_jwt_secret_key_here
CORS_ORIGIN=https://your-dashboard.example.com

# ZADX SMS provider (server-side only; never expose these values to mobile/dashboard)
SMS_PROVIDER=zadx
SMS_API_URL=https://smsapi.zadx.net
SMS_API_KEY=
SMS_API_SECRET=
SMS_TIMEOUT_MS=15000
