{
  "expo": {
    "name": "FIXION",
    "slug": "fixion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fixion",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixion.center",
      "supportsRTL": true
    },
    "android": {
      "package": "com.fixion.center",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "supportsRTL": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "السماح بالوصول للكاميرا لمسح كروت الطلاب"
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "c322c5dd-f70f-4942-92af-e50464f8b91b"
      }
    },
    "owner": "abdo-m7"
  }
}
